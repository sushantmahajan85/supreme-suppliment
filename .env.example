# Copy to .env and fill in. NEVER commit .env or expose the secret in frontend code.
PORT=3000

# Razorpay Dashboard -> Account & Settings -> API Keys (use rzp_test_* keys until you go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard -> Webhooks. URL: https://<your-domain>/api/webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Authoritative price in paise (₹3,499 = 349900). Must match the price shown on the page.
UNIT_PRICE_PAISE=349900
MAX_QTY=10

# Only if the static site is hosted on a different origin than this server
# ALLOWED_ORIGIN=https://www.example.com
